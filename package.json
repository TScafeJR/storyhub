{
  "name": "storyhub",
  "version": "0.5.2",
  "description": "One Storybook for all your git worktrees: opt-in branch sections that show only the stories each branch changes, for Vite and webpack, with a CLI and MCP server",
  "keywords": [
    "storybook",
    "storybook-addon",
    "git",
    "worktree",
    "worktrees",
    "branches",
    "mcp",
    "vite",
    "webpack",
    "tailwind"
  ],
  "homepage": "https://github.com/TScafeJR/storyhub#readme",
  "bugs": {
    "url": "https://github.com/TScafeJR/storyhub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TScafeJR/storyhub.git"
  },
  "license": "MIT",
  "author": "Tyrone Scafe",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "default": "./dist/webpack.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js",
      "require": "./dist/tailwind.cjs"
    },
    "./preset": "./preset.js",
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "storyhub": "./dist/cli.js"
  },
  "files": [
    "dist",
    "preset.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "pnpm build && vitest run --project e2e",
    "fixture": "node test/fixtures/create-fixture.mjs",
    "screenshots": "pnpm build && node scripts/screenshots.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test",
    "release:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm pack --dry-run",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "storybook": "^10.5.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "webpack": "^5.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "oxlint": "1.91.0",
    "playwright": "1.64.1",
    "postcss": "8.4.49",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.4",
    "tailwindcss": "4.3.4",
    "tailwindcss3": "npm:tailwindcss@3.4.17",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webpack": "5.112.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "storybook": {
    "displayName": "storyhub",
    "supportedFrameworks": [
      "react"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  }
}
