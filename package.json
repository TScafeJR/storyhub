{
  "name": "storyhub",
  "version": "0.1.0",
  "description": "Render every git worktree's UI changes as branch sections in a single Storybook, with MCP support",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "storybook",
    "storybook-addon",
    "git",
    "worktree",
    "mcp"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preset": "./preset.js",
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "storyhub": "./dist/cli.js"
  },
  "files": [
    "dist",
    "preset.js",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "npm run build && vitest run --project e2e",
    "fixture": "node test/fixtures/create-fixture.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "chokidar": "5.0.0",
    "oxc-parser": "0.158.0",
    "picomatch": "4.0.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "storybook": "^10.5.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.4",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
